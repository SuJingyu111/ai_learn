build*/
.DS_Store
.cache/
.vscode/
.idea/
*.o
*.a
*.so
*.dylib
*.exe
# Large profiler traces stay out of the repository; raw benchmark CSV/JSON in
# benchmark-results/ is tracked on purpose — it is the primary evidence that
# docs/benchmark-methodology.md and the G8 hard blockers depend on.
*.nsys-rep
*.ncu-rep
*.sqlite
notes/daily/*.md
!notes/daily/.gitkeep
__pycache__/
*.pyc
.venv*/

# Model files are fetched, not committed; see scripts/fetch_models.sh
models/*.onnx
models/*.bin
models/*.npy
*.tt
